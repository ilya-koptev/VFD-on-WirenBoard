{
  "device_type": "VFD MN12832L",
  "device": {
    "name": "VFD MN12832L",
    "id": "vfd-mn12832l",
    "protocol": "modbus",
    "response_timeout_ms": 300,
    "frame_timeout_ms": 20,
    "groups": [
      { "id": "content", "title": "Content", "order": 1 },
      { "id": "view", "title": "View", "order": 2 },
      { "id": "time", "title": "Time", "order": 3 },
      { "id": "hw", "title": "Hardware", "order": 4 }
    ],
    "channels": [
      { "name": "Text 1", "reg_type": "holding", "address": 64,
        "type": "text", "format": "string8", "string_data_size": 24, "group": "content" },
      { "name": "Text 2", "reg_type": "holding", "address": 80,
        "type": "text", "format": "string8", "string_data_size": 24, "group": "content" },
      { "name": "Text 3", "reg_type": "holding", "address": 96,
        "type": "text", "format": "string8", "string_data_size": 24, "group": "content" },
      { "name": "Text 4", "reg_type": "holding", "address": 112,
        "type": "text", "format": "string8", "string_data_size": 24, "group": "content" },

      { "name": "Mode", "reg_type": "holding", "address": 16,
        "type": "range", "min": 0, "max": 6, "group": "view" },
      { "name": "Font", "reg_type": "holding", "address": 17,
        "type": "range", "min": 0, "max": 2, "group": "view" },
      { "name": "Digit set", "reg_type": "holding", "address": 18,
        "type": "range", "min": 0, "max": 3, "group": "view" },
      { "name": "Brightness", "reg_type": "holding", "address": 20,
        "type": "range", "min": 0, "max": 220, "group": "view" },
      { "name": "Invert", "reg_type": "holding", "address": 21,
        "type": "switch", "group": "view" },

      { "name": "Unix time", "reg_type": "holding", "address": 32,
        "type": "value", "format": "u32", "group": "time" },
      { "name": "TZ offset", "reg_type": "holding", "address": 34,
        "type": "value", "format": "s16", "group": "time" },

      { "name": "Frame time", "reg_type": "holding", "address": 48,
        "type": "value", "readonly": true, "group": "hw" },
      { "name": "Slot time", "reg_type": "holding", "address": 49,
        "type": "value", "readonly": true, "group": "hw" },
      { "name": "Uptime", "reg_type": "holding", "address": 50,
        "type": "value", "format": "u32", "readonly": true, "group": "hw" },
      { "name": "Bad frames", "reg_type": "holding", "address": 52,
        "type": "value", "readonly": true, "group": "hw" },
      { "name": "Signature", "reg_type": "holding", "address": 290,
        "type": "text", "format": "string", "string_data_size": 12, "readonly": true, "group": "hw" },
      { "name": "FW version", "reg_type": "holding", "address": 250,
        "type": "text", "format": "string", "string_data_size": 8, "readonly": true, "group": "hw" }
    ],
    "translations": {
      "ru": {
        "VFD MN12832L": "VFD-дисплей MN12832L",
        "Content": "Содержимое",
        "View": "Отображение",
        "Time": "Время",
        "Hardware": "Устройство",
        "Text 1": "Строка 1",
        "Text 2": "Строка 2",
        "Text 3": "Строка 3",
        "Text 4": "Строка 4",
        "Mode": "Режим",
        "Font": "Шрифт",
        "Digit set": "Набор цифр",
        "Brightness": "Яркость, мкс",
        "Invert": "Инверсия",
        "Unix time": "Время, unix",
        "TZ offset": "Смещение зоны, мин",
        "Frame time": "Время кадра, мкс",
        "Slot time": "Период слота, мкс",
        "Uptime": "Наработка, с",
        "Bad frames": "Битых кадров",
        "Signature": "Подпись",
        "FW version": "Версия прошивки"
      }
    }
  }
}
